{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CUDA debug (cuda-gdb)",
      "type": "cuda-gdb",
      "request": "launch",
      "program": "/home/mahaotian/miniconda3/envs/py310/bin/python",
      "args": ["launch.py"],
      "cwd": "${workspaceFolder}/examples/cutlass_examples/hgemm_cutlass_sm80",
      "environment": [{ "name": "CUDA_LAUNCH_BLOCKING", "value": "1" }],
      "stopAtEntry": false,
      "debuggerPath": "/usr/local/cuda/bin/cuda-gdb"
    },
    {
      "name": "Host debug (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/root/miniconda3/bin/python",
      "args": ["launch.py"],
      "cwd": "${workspaceFolder}/examples/cutlass_examples/hgemm_cutlass_sm80",
      "MIMode": "gdb",
      "environment": [{ "name": "CUDA_LAUNCH_BLOCKING", "value": "1" }],
      "stopAtEntry": false
    }
  ]
}